# Deployer wallet (needs USDC on Arc for gas). NEVER commit the real .env.
DEPLOYER_PRIVATE_KEY=

# Who resolves disputes / owns the contract (default: deployer)
ARBITRATOR_ADDRESS=
OWNER_ADDRESS=

# RPC endpoints (defaults are used if left empty)
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
