# Tetscrow backend — environment variables. Copy to .env and fill in.

# Arc RPC. Testnet: https://rpc.testnet.arc.io  |  Mainnet: https://rpc.mainnet.arc.io
RPC_URL=https://rpc.testnet.arc.io
# Fallback RPC tried automatically if the primary is unreachable
RPC_URL_FALLBACK=https://rpc.testnet.arc.network

# Arc Testnet: 5042002  |  Arc Mainnet: 5042
CHAIN_ID=5042002

# Address printed by contracts/scripts/deploy.js
TETSCROW_ESCROW_ADDRESS=

# Arc USDC (same address on both networks)
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Auth — use a long random string, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=1440

# Database (use Postgres in production)
DATABASE_URL=sqlite:///./tetscrow.db

# Comma-separated list of allowed browser origins
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Dev only: skip verifying confirm calls against the chain (leave 0 otherwise)
SKIP_ONCHAIN_VERIFY=0
